<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Swissactive.WanderungenPage"
             Title="Wanderungen">
    <Grid RowDefinitions="Auto, *">
        <SearchBar x:Name="WanderSearch" Placeholder="Suche..." TextChanged="OnSearchTextChanged" />
        <CollectionView Grid.Row="1" x:Name="WanderungenList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="10" Padding="10" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                        <Grid ColumnDefinitions="100, *">
                            <Image Source="{Binding Bild}" Aspect="AspectFill" HeightRequest="100" WidthRequest="100" />
                            <VerticalStackLayout Grid.Column="1" Padding="15,0" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="Black" FontSize="18" />
                                <Label Text="{Binding Kanton}" TextColor="Gray" />
                                <Button Text="Details" Clicked="OnDetailsClicked" BackgroundColor="White" Margin="0,5" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>