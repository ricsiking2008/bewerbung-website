<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Swissactive.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Image Source="swissactive_logo.png" HeightRequest="100" HorizontalOptions="Center" />

        <Label Text="Anmelden" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black" />

        <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" TextColor="Black" />
        <Entry x:Name="PasswortEntry" Placeholder="Passwort" IsPassword="True" TextColor="Black" />

        <HorizontalStackLayout Spacing="10">
            <Switch x:Name="StayLoggedIn" />
            <Label Text="Angemeldet bleiben" VerticalOptions="Center" TextColor="Black" />
        </HorizontalStackLayout>

        <Button Text="Login" Clicked="OnLoginSubmitClicked" BackgroundColor="Black" TextColor="White" HeightRequest="50" CornerRadius="25" />
        <Button Text="Abbrechen" Clicked="OnCancelClicked" BackgroundColor="Transparent" TextColor="Gray" />
    </VerticalStackLayout>
</ContentPage>