<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Swissactive.WanderungDetailPage"
             Title="Details"
             BackgroundColor="White">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Image x:Name="DetailImage" HeightRequest="250" Aspect="AspectFill" />
        <Label x:Name="NameLabel" FontSize="28" FontAttributes="Bold" TextColor="Black" />
        <Label x:Name="KantonLabel" FontSize="18" TextColor="#09BC8A" />
        <Button Text="In Favoriten speichern" Clicked="OnFavoriteClicked" BackgroundColor="Gold" TextColor="Black" FontAttributes="Bold" HeightRequest="50" />
    </VerticalStackLayout>
</ContentPage>